# syntax=docker/dockerfile:1

# ==============================================================================
# Dockerfile de desenvolvimento — usado pelo docker-compose.yml.
#
# Diferente do Dockerfile de produção: instala tudo (incluindo devDependencies),
# não faz build, e roda `next dev`. O código-fonte é montado por volume no
# compose (não copiado aqui), então mudanças no host refletem instantaneamente.
# ==============================================================================

FROM node:20-alpine
# openssl: o schema-engine do Prisma (usado por `prisma migrate dev`) precisa
# dele pra rodar no Alpine — sem isso, comandos de migration falham no fim
# com "Could not parse schema engine response" mesmo já tendo aplicado a
# migration com sucesso.
# tzdata: fixa o fuso horário do processo (ver ENV TZ abaixo) — camada extra
# de proteção, não a correção principal (essa mora em src/lib/timezone.ts,
# ver openspec/changes/corrigir-fuso-horario-agenda/design.md, Decisão 4).
RUN apk add --no-cache libc6-compat openssl tzdata
# Fuso horário da clínica — sem isso, o container roda em UTC por padrão
# (Alpine), divergindo do fuso do Brasil.
ENV TZ=America/Sao_Paulo
WORKDIR /app

# `npm install` roda o script "postinstall" (prisma generate), que precisa:
#   1. do schema.prisma já presente
#   2. de DATABASE_URL definida (só para o parser conseguir ler o schema —
#      não conecta de fato nesta etapa)
ENV DATABASE_URL="postgresql://postgres:postgres@db:5432/matilha?schema=public"
COPY package.json ./
COPY prisma ./prisma
RUN npm install

EXPOSE 3000
CMD ["npm", "run", "dev"]
