# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env de verdade.

# String de conexão do Postgres.
# - Rodando local sem Docker: host "localhost" (Postgres precisa estar rodando
#   na sua máquina, ex: via `docker run postgres` avulso, ou instalado direto).
# - Rodando com docker-compose (docker-compose.yml ou .prod.yml): o app já
#   sobrescreve isso automaticamente para usar "db" como host (nome do serviço
#   do Postgres na rede interna do compose) — o valor abaixo é só para uso
#   fora do Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matilha?schema=public"

# Auth.js — gere um valor com: openssl rand -base64 32
# Em docker-compose.yml (dev) há um valor default se este ficar vazio.
# Em docker-compose.prod.yml isso é OBRIGATÓRIO, sem default.
AUTH_SECRET=""

# URL pública da aplicação (usada pelo Auth.js para callbacks)
NEXTAUTH_URL="http://localhost:3000"
